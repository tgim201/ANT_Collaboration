{
  "rules": {
    "ontology_meta": {
      ".read": true,
      ".write": true
    },
    "interviews": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt", "targetActor", "speaker"]
    },
    "network_snapshots": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt", "cohesionScore"]
    }
  }
}

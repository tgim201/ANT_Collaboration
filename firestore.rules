rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /interviews/{docId} {
      allow read, write: if true;
    }
    match /network_snapshots/{docId} {
      allow read, write: if true;
    }
    match /ontology_meta/{docId} {
      allow read, write: if true;
    }
  }
}
